{
  "name": "taicore-brand",
  "version": "0.1.0",
  "description": "钛核 TAICORE 品牌占位：侧栏标志/名称、会话首屏品牌位、主题 token 覆盖（PoC）",
  "type": "module",
  "main": "./lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
