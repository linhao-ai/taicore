{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TAICORE",
  "version": "1.1.0",
  "identifier": "com.taicore.desktop",
  "build": {
    "frontendDist": "../../../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "<替换成你自己的 minisign 公钥>",
      "endpoints": [
        "https://updates.taicore.app/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../../../sidecar/": "sidecar/",
      "../../../ui/": "ui/",
      "../../../pp/": "dsh-desktop/",
      "../../../dlls/D3DCOMPILER_47.dll": "D3DCOMPILER_47.dll"
    },
    "externalBin": [],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installerHooks.nsh",
        "template": "nsis/installer-template.nsi"
      }
    }
  }
}
